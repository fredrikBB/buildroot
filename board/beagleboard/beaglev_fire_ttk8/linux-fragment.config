CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# The USB configs are inspired from:
# https://github.com/beagleboard/BeagleV-Fire-ubuntu/blob/main/build_linux_menuconfig.sh

# Core USB gadget / MUSB (PolarFire) support
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_MUSB_POLARFIRE_SOC=y
CONFIG_USB_MUSB_DUAL_ROLE=y

# Configfs / libcomposite + ACM function (use configfs to create ACMs)
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_ACM=y